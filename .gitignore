# ==========================================
# 1. Credenciais e Variáveis de Ambiente
# ==========================================
# Arquivos de credenciais reais - NUNCA versionados
.env
profiles.yml
.user.yml

# Templates de exemplo - versionados para ajudar novos usuários
!.env.example
!profiles.yml.example

# ==========================================
# 2. Ambientes Virtuais Python
# ==========================================
venv/
env/
*venv/
*env/
.venv/

# ==========================================
# 3. Caches e Binários Python
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# ==========================================
# 4. Artefatos e Logs do dbt
# ==========================================
target/
**/target/
dbt_packages/
**/dbt_packages/
logs/
**/logs/
*.log

# ==========================================
# 5. Dados Locais e Volumes de Aplicações
# ==========================================
metabase-data/
**/metabase-data/
*.mv.db
*.trace.db
pg_data/
**/pg_data/

# ==========================================
# 6. Dados Brutos e Arquivos Temporários
# ==========================================
# Ignoramos apenas dados da camada de processamento, não fontes/config
*.parquet
*.json
*.csv
# Dados brutos da Binance após processamento
binance_*/**/bronze_*

# ==========================================
# 7. Arquivos de Sistema Operacional e IDE
# ==========================================
.DS_Store
Thumbs.db
.vscode/